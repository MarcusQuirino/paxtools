{
  "name": "paxtools",
  "version": "1.8.0",
  "description": "Rastreador de Progressao Pessoal para escoteiros brasileiros do Ramo Escoteiro",
  "license": "AGPL-3.0-only",
  "type": "module",
  "types": ".design-sync/.cache/dts/.design-sync/entry.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/MarcusQuirino/paxtools.git"
  },
  "scripts": {
    "dev": "bunx concurrently --names convex,vite -c cyan,magenta \"bunx convex dev\" \"vite dev\"",
    "dev:frontend": "vite dev",
    "dev:backend": "bunx convex dev",
    "build": "vite build",
    "test": "bun test src convex",
    "test:e2e": "TEST_AUTH=1 playwright test",
    "test:e2e:ui": "TEST_AUTH=1 playwright test --ui",
    "test:e2e:staging": "E2E_TARGET=staging TEST_AUTH=1 playwright test",
    "test:e2e:seed": "TEST_AUTH=1 bunx convex run testing:seedTestUsers && TEST_AUTH=1 bunx convex run testing:seedSimulatedTroop",
    "test:e2e:wipe": "TEST_AUTH=1 bunx convex run testing:wipeTestData",
    "test:e2e:reset": "bun run test:e2e:wipe && bun run test:e2e:seed",
    "staging:seed": "bunx convex run --deployment staging testing:seedTestUsers && bunx convex run --deployment staging testing:seedSimulatedTroop",
    "staging:wipe-real": "bunx convex run --deployment staging testing:wipeRealUsers",
    "staging:reset": "bunx convex run --deployment staging testing:wipeTestData && bun run staging:seed",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.125",
    "@auth/core": "0.41.3",
    "@convex-dev/auth": "^0.0.95",
    "@convex-dev/migrations": "^0.3.6",
    "@convex-dev/react-query": "^0.1.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@t3-oss/env-core": "^0.13.11",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-router-ssr-query": "^1.167.3",
    "@tanstack/react-start": "^1.168.60",
    "ai": "^6.0.296",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "convex": "^1.46.0",
    "lucide-react": "^0.545.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.4",
    "convex-test": "^0.0.60",
    "nitro": "^3.0.260903-beta",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vite": "^8.3.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
