# Convex deployment config
# Run `bunx convex dev --once` to generate your .env.local automatically
CONVEX_DEPLOYMENT=dev:your-project-name
VITE_CONVEX_URL=https://your-project-name.convex.cloud
VITE_CONVEX_SITE_URL=https://your-project-name.convex.site

# E2E test auth (local dev / staging only — NEVER set on production).
# convex/testing.ts refuses to run on the prod deployment regardless, and
# deploy-prod.yml fails the release if either var is set there.
#
# TEST_AUTH=1 enables the seed/wipe functions in convex/testing.ts.
# TEST_AUTH_PASSWORD is the shared password for seeded test personas. No
# default: it must be set BOTH on the Convex deployment being seeded
# (`bunx convex env set TEST_AUTH_PASSWORD <value>`) and in the shell running
# Playwright (`export TEST_AUTH_PASSWORD=...`), with the same value. Pick a
# random value; don't reuse a real password. See docs/agents/running-locally.md.
TEST_AUTH=
TEST_AUTH_PASSWORD=
